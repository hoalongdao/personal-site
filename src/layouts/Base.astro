---
import { SITE_NAME, SITE_DESC, url } from '../lib/content';
interface Props { title?: string; description?: string }
const { title, description = SITE_DESC } = Astro.props;
const fullTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={url('rss.xml')} />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
</head>
<body>
  <header class="site-header">
    <div class="wrap nav">
      <a class="brand" href={url('')}>{SITE_NAME}</a>
      <nav>
        <a href={url('exclusives/')}>Exclusives</a>
        <a href={url('digests/')}>Digests</a>
        <a href={url('dashboard/')}>Dashboard</a>
        <a href={url('rss.xml')}>RSS</a>
      </nav>
    </div>
  </header>
  <main class="wrap"><slot /></main>
  <footer class="wrap site-footer">© {new Date().getUTCFullYear()} {SITE_NAME}</footer>
</body>
</html>
<style is:global>
  :root { --fg:#111; --muted:#666; --bg:#fff; --line:#e5e5e5; --accent:#d4380d; --card:#fafafa; }
  @media (prefers-color-scheme: dark) { :root { --fg:#eee; --muted:#999; --bg:#111; --line:#2a2a2a; --accent:#ff7a45; --card:#181818; } }
  * { box-sizing: border-box; }
  body { margin:0; font:17px/1.65 system-ui,-apple-system,'Segoe UI',Roboto,sans-serif; color:var(--fg); background:var(--bg); }
  a { color:inherit; }
  .wrap { max-width: 760px; margin: 0 auto; padding: 0 20px; }
  .site-header { border-bottom:1px solid var(--line); }
  .nav { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; padding-top:14px; padding-bottom:14px; }
  .brand { font-weight:800; text-decoration:none; font-size:1.15rem; }
  nav a { margin-left:16px; text-decoration:none; color:var(--muted); font-size:.95rem; }
  nav a:first-child { margin-left:0; }
  nav a:hover { color:var(--fg); }
  main { padding-top: 28px; padding-bottom: 48px; }
  h1 { line-height:1.2; font-size:2rem; margin:.2em 0 .4em; }
  h2 { line-height:1.25; }
  .muted { color:var(--muted); }
  .label { text-transform:uppercase; letter-spacing:.08em; font-size:.75rem; font-weight:700; color:var(--accent); }
  .card { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:18px 20px; margin:18px 0; }
  .list { list-style:none; padding:0; margin:0; }
  .list li { padding:12px 0; border-bottom:1px solid var(--line); }
  .list a { text-decoration:none; font-weight:600; }
  .list a:hover { text-decoration:underline; }
  .tags span { font-size:.8rem; color:var(--muted); margin-right:8px; }
  .empty { color:var(--muted); font-style:italic; }
  article img { max-width:100%; height:auto; }
  article pre { overflow-x:auto; }
  table { width:100%; border-collapse:collapse; font-size:.92rem; }
  th, td { text-align:left; padding:6px 8px; border-bottom:1px solid var(--line); }
  .table-wrap { overflow-x:auto; }
  .site-footer { color:var(--muted); font-size:.85rem; padding-bottom:32px; border-top:1px solid var(--line); padding-top:16px; }
  @media (max-width: 520px) { body { font-size:16px; } h1 { font-size:1.6rem; } nav a { margin-left:12px; } }
</style>
