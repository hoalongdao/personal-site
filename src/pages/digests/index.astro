---
import Base from '../../layouts/Base.astro';
import { allDigests, slugOf, url, fmtDate } from '../../lib/content';
const items = await allDigests();
---
<Base title="Digests">
  <h1>Digests</h1>
  {items.length ? (
    <ul class="list">{items.map((e) => <li><a href={url(`digests/${slugOf(e)}/`)}>{e.data.title}</a> <span class="muted">· {fmtDate(e.data.date)}</span>{e.data.excerpt && <div class="muted">{e.data.excerpt}</div>}</li>)}</ul>
  ) : <p class="empty">No Digests published yet.</p>}
</Base>
