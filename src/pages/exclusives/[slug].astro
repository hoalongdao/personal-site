---
import { render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { publicExclusives, slugOf } from '../../lib/content';
export async function getStaticPaths() {
  const items = await publicExclusives(); // members:true never generated
  return items.map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Post kind="Exclusive" title={entry.data.title} date={entry.data.date} excerpt={entry.data.excerpt} tags={entry.data.tags}>
  <Content />
</Post>
